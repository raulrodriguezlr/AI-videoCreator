# =======================
# AI-videoCreator .gitignore
# =======================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# --- Virtual Environment ---
.venv/
venv/
env/

# --- Environment & Secrets ---
.env
.env.local
.env.production

# --- Generated Assets (regenerable) ---
#pods/*/assets/*.png
#pods/*/assets/*.mp3
#pods/*/assets/*.mp4
#pods/*/output/

# --- Media files (generated, not source) ---
#*.mp4
#*.mp3
#*.wav

# --- PDFs (generated docs) ---
*.pdf

# --- OS generated ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- GSD State Files ---
.gsd/

# --- Agent/AI tool configs ---
# .agent
# .gemini
# model_capabilities.yaml
