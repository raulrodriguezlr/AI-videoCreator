*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# --- Virtual Environment ---
.venv/
venv/
env/

# --- Environment & Secrets ---
.env
.env.local
.env.production
client_secret*.json
youtube_token*.json

# # --- Generated Assets (regenerable) ---
# pods/*/assets/*.png
# pods/*/assets/*.mp3
# pods/*/assets/*.mp4
# pods/*/output/

# --- Media files (generated, not source) ---
# *.mp4
*.mp3
*.wav

# --- PDFs (generated docs) ---
*.pdf

# --- OS generated ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- GSD State Files ---
.gsd/

# --- Agent/AI tool configs ---
# .agent
# .gemini
# model_capabilities.yaml

# --- Generated Assets (regenerable) ---
pods/*/assets/*.png
pods/*/assets/*.mp3
pods/*/assets/*.mp4
pods/*/output/

# --- Agents ---
pods/*/.agent.md
pods/*/persona.md

# --- v3.0 backend local-mode data ---
var/
backend/.venv/
backend/var/
*.sqlite
*.sqlite3
*.db

# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/dev.log
frontend/dev.err.log
frontend/*.tsbuildinfo

# --- Claude Code workspace ---
.claude/
Claude.md
